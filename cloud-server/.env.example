# Cópialo a .env y llena los valores reales. .env NUNCA se sube a Git.

# Token que te da @BotFather al crear el bot (Fase 4 del plan)
TELEGRAM_BOT_TOKEN=

# Username del bot SIN @, ej si tu bot es @BeatGalerBot, pon: BeatGalerBot
TELEGRAM_BOT_USERNAME=

# Puerto local del servidor (opcional, default 4000)
PORT=4000
