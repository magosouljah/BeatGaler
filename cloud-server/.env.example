# Cópialo a .env y llena los valores reales. .env NUNCA se sube a Git.

# 001BeatGaler is MANAGER ONLY. It is not a vault member and has no /start,
# commands, uploads, downloads, topics or index role. Its token appears only
# below as MANAGER_BOT_TOKEN_1.

# Puerto local del servidor (opcional, default 4000)
PORT=4000
# BeatGaler account OAuth (Google / X)
# Must be the public HTTPS URL that reaches this cloud-server, without a trailing slash.
BEATGALER_OAUTH_PUBLIC_BASE=https://your-beatgaler-cloud.example.com

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X Developer Portal OAuth 2.0 credentials
X_CLIENT_ID=
X_CLIENT_SECRET=


# ── Telegram Direct transport (Phase 6 prototype integrated) ──────────────
# Large media no longer needs to pass through this HTTP server. The desktop
# receives the current Managed Bot credential for its lease and sends/reads media
# by MTProto. The token is NOT rotated at lease start; it rotates after a session ends.
BEATGALER_DIRECT_TRANSPORT=true
BEATGALER_DIRECT_REQUIRED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Existing authorized technical MASTER account. You may keep using the
# cloud-server/master-session.txt produced by setup-master-account.js instead.
# BEATGALER_MASTER_SESSION=
# MASTER_SESSION_FILE=C:\\BeatGaler\\secrets\\master-01-session.txt

# Load-balanced FIFO Managed Bot pool. Bots may serve multiple active vaults;
# the scheduler fills load level 1 across every bot before assigning level 2, etc.
# Real transport bot tokens are never stored here.
TRANSPORT_BOTS_FILE=./transport-bots.local.json
TRANSPORT_POOL_STATE=./transport-pool-state.json
MANAGER_BOT_TOKEN_1=
MANAGER_BOT_USERNAME_1=001BeatGalerBot
POOL_LOCK_WAIT_MS=5000
DIRECT_HEARTBEAT_INTERVAL_MS=60000
DIRECT_HEARTBEAT_TIMEOUT_MS=300000

# MASTER sharding / vault lookup only. Normal library-index bytes are handled
# by the active transport bot, not MASTER.
MASTERS_FILE=./masters.local.json
VAULT_REGISTRY_FILE=./vault-registry.json
MASTER_VAULT_SOFT_LIMIT=400
MASTER_DIALOG_LIMIT=1000

# Direct V5 test mode: token rotation/revoke is intentionally OFF.
# Re-enable later after the Bot API Local path is proven stable.
DIRECT_TOKEN_ROTATION_ENABLED=false

# BeatGaler Desktop talks to this Bot API server on THE USER'S PC.
# For current dev testing it is expected on localhost:8081 and must run with --local.
DIRECT_LOCAL_BOT_API_BASE=http://127.0.0.1:8081

# Optional override. If blank, MASTER automatically creates one private internal
# "BeatGaler Transport Resolver" group and permanently adds the transport pool.
# This group is NOT a user vault. It lets a newly assigned bot resolve an old
# Telegram message_id into a bot-specific file_id without posting in the vault.
DIRECT_BOTAPI_RESOLVER_CHAT_ID=

# Security architecture v1
# Production browser origins allowed to call the BeatGaler API, comma-separated.
# Example: https://app.beatgaler.com,https://beatgaler.com
BEATGALER_ALLOWED_ORIGINS=

# Private developer/admin diagnostics only. Never ship this value to Desktop/Web.
BEATGALER_ADMIN_KEY=
