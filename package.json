{
  "name": "beat-galer",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/patch-wry-pinterest.mjs && tsc && vite build",
    "preview": "vite preview",
    "version:set": "node scripts/version.mjs set",
    "version:bump": "node scripts/version.mjs bump-patch",
    "build:release": "npm run version:check && npm run tauri build",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-tauri.ps1",
    "test:regressions": "node scripts/run-regressions.mjs",
    "check": "npm run test:fast && npm run build",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:show": "node scripts/version.mjs show",
    "github:save": "node scripts/github-save.mjs",
    "github:branch": "node scripts/github-save.mjs --print-branch",
    "patch:wry-pinterest": "node scripts/patch-wry-pinterest.mjs",
    "test:unit": "npm run test:unit:ts && npm run test:component:dom && npm run test:unit:rust && npm run test:unit:cloud",
    "test:fast": "npm run test:unit && npm run test:integration && npm run test:regressions",
    "test": "npm run test:fast",
    "test:unit:ts": "node scripts/run-unit-tests.mjs",
    "test:unit:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:unit:cloud": "node cloud-server/tests/unit.test.cjs",
    "test:component:dom": "vitest run tests/component-dom --environment jsdom",
    "test:integration": "vitest run tests/integration --environment jsdom",
    "test:e2e:desktop:build": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release",
    "test:e2e:desktop": "npm run test:e2e:desktop:build && wdio run wdio.e2e.conf.mjs",
    "test:e2e:import": "node scripts/run-import-e2e.mjs",
    "test:e2e:downloads": "node scripts/run-downloads-e2e.mjs",
    "test:e2e:recovery": "node scripts/run-recovery-e2e.mjs",
    "test:updater-manifest": "node scripts/updater-manifest.mjs validate",
    "updater:keygen": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\setup-updater-signing.ps1",
    "updater:verify-artifacts": "node scripts/verify-updater-artifacts.mjs",
    "updater:manifest": "node scripts/updater-manifest.mjs",
    "updater:test-baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-updater-test-baseline.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.0.3",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-shell": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
