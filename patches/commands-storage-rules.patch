+fn normalized_beat_name_key(name: &str) -> String {
+    name.split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+        .trim()
+        .to_lowercase()
+}
+
+fn ensure_unique_beat_name(conn: &Connection, beat: &BeatMeta) -> rusqlite::Result<()> {
+    let wanted = normalized_beat_name_key(&beat.name);
+    if wanted.is_empty() {
+        return Err(rusqlite::Error::InvalidParameterName(
+            "Beat name cannot be empty.".to_string(),
+        ));
+    }
+
+    let mut stmt = conn.prepare("SELECT id, meta_json FROM beats WHERE id<>?1")?;
+    let rows = stmt.query_map(params![beat.id.clone()], |row| {
+        Ok((row.get::<_, String>(0)?, row.get::<_, Option<String>>(1)?))
+    })?;
+
+    for row in rows {
+        let (_id, raw) = row?;
+        let Some(raw) = raw else { continue; };
+        let Ok(existing) = serde_json::from_str::<BeatMeta>(&raw) else { continue; };
+        if normalized_beat_name_key(&existing.name) == wanted {
+            return Err(rusqlite::Error::InvalidParameterName(format!(
+                "A beat named '{}' already exists. Beat names must be unique.",
+                beat.name
+            )));
+        }
+    }
+
+    // Trash reserves the name too. Otherwise a new active beat could take the
+    // same name and make the original impossible to restore without conflict.
+    let mut trash_stmt = conn.prepare("SELECT beat_name FROM trash")?;
+    let trash_names = trash_stmt.query_map([], |row| row.get::<_, String>(0))?;
+    for name in trash_names {
+        if normalized_beat_name_key(&name?) == wanted {
+            return Err(rusqlite::Error::InvalidParameterName(format!(
+                "A beat named '{}' already exists in Trash. Restore or permanently remove it before reusing the name.",
+                beat.name
+            )));
+        }
+    }
+    Ok(())
+}
