+
+fn adopt_mp3_metadata_if_empty(beat: &BeatMeta, source: &Path) -> BeatMeta {
+    let is_mp3 = source.extension()
+        .and_then(|v| v.to_str())
+        .map(|v| v.eq_ignore_ascii_case("mp3"))
+        .unwrap_or(false);
+    if !is_mp3 || !beat_metadata_is_empty(beat) {
