+        || image_base64.as_deref().map(|v| !v.trim().is_empty()).unwrap_or(false);
+    if !has_source_metadata {
+        return beat.clone();
+    }
+
+    let mut adopted = beat.clone();
+    adopted.bpm = bpm;
