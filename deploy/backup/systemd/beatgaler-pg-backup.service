[Unit]
Description=BeatGaler PostgreSQL encrypted catalog backup to S3
Wants=network-online.target
After=network-online.target
# Deploy only after an isolated S3 restore has been verified.

[Service]
Type=oneshot
User=beatgaler-backup
Group=beatgaler-backup
EnvironmentFile=/etc/beatgaler/catalog-backup.env
WorkingDirectory=/opt/beatgaler
ExecStart=/usr/bin/bash /opt/beatgaler/scripts/backup/pg-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=45min
