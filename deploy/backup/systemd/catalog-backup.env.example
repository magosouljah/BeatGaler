# TEMPLATE ONLY. Do not commit real values, passphrases, URLs with passwords, or tokens.
# Copy to /etc/beatgaler/catalog-backup.env, mode 0600, owned by root.
# Deploy only for the explicitly approved AWS account, region and database.
# Runtime must have a dedicated S3 writer-only IAM role (no delete or read).
BACKUP_DB=REPLACE_DB
BACKUP_TARGET=s3://REPLACE_UNIQUE_BUCKET/catalog/
BACKUP_PASSPHRASE_FILE=/etc/beatgaler/catalog-backup.pass
PGHOST=REPLACE_PG_HOST
PGPORT=5432
PGUSER=REPLACE_READ_ONLY_BACKUP_USER
PGPASSFILE=/etc/beatgaler/catalog-backup.pgpass
AWS_DEFAULT_REGION=REPLACE_AWS_REGION
S3_SSE_KMS_KEY_ID=REPLACE_KEY_ARN
